# The dapp needs exactly this to run against ANY chain: a chain id, two addresses, and (optionally) a read RPC.
# These defaults are the Terrarium scenario: the real Uniswap V2 Router02 at its mainnet address, and PEPE at the
# address the treasury account deploys it to (its first transaction, so deterministic).
VITE_CHAIN_ID=31337
VITE_ROUTER_ADDRESS=0x7a250d5630B4cF539739dF2C5dAcb4c659F2488D
VITE_TOKEN_ADDRESS=0x700b6A60ce7EaaEA56F065753d8dcB9653dbAD35
# VITE_RPC_URL=https://...   # read endpoint; without it the dapp reads through the wallet it finds
# The indexer the dapp queries for recent swaps and volume (GraphQL). Under the Terrarium this exact URL is answered
# from the chain in the page; without it (VITE_TERRARIUM=off) the dapp really calls it.
VITE_SUBGRAPH_URL=https://api.thegraph.com/subgraphs/name/uniswap/uniswap-v2
# VITE_TERRARIUM=off         # build/serve the plain dapp without injecting the simulated chain
