{
  "name": "terrarium",
  "version": "0.3.0",
  "description": "A complete EVM chain inside the page, presented to your dapp as a wallet. revm in WebAssembly, real receipts, byte-identical to Anvil.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "terrarium": "./bin/terrarium.mjs"
  },
  "exports": {
    ".": "./src/engine.js",
    "./engine": "./src/engine.js",
    "./scenario": "./src/scenario.ts",
    "./worker": "./src/worker-runtime.ts",
    "./inject": "./src/inject.ts",
    "./bridge": "./src/bridge.ts",
    "./http": "./src/http.ts",
    "./vite": "./src/vite-plugin.ts",
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "src",
    "bin",
    "fixtures"
  ],
  "dependencies": {
    "@ethereumjs/block": "^10.1.3",
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/statemanager": "^10.1.3",
    "@ethereumjs/tx": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@ethereumjs/mpt": "^10.1.3",
    "@ethereumjs/rlp": "^10.0.0",
    "terrarium-evm": "*"
  },
  "peerDependencies": {
    "viem": "^2.0.0",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
